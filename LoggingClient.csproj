<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageId>ManagementLoggingClient</PackageId>
    <Version>2.0.0</Version>
    <Authors>Jhoan Hurtado</Authors>
    <Company>JhoanHurtado</Company>
    <Description>Biblioteca para .NET 8 y .NET 10 para la gestión centralizada y multi-fuente de logs (AWS CloudWatch, Archivos Locales, Consola y proveedores personalizados), con API fluida, inicialización automática y soporte nativo para JSON estructurado.</Description>
    <PackageTags>logging;cloudwatch;aws;json;exceptions;multilogger;fluent</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/JhoanHurtado/LoggingClient.git</RepositoryUrl>
    <PackageReleaseNotes>Versión 2.0.0:
    - Nuevo LogClientBuilder fluido para configurar múltiples fuentes en pocas líneas.
    - Nuevo CompositeLoggerService para enviar logs simultáneamente a CloudWatch, Archivo Local, Consola, etc.
    - Inicialización automática (lazy) en CloudWatch (ya no requiere llamar a InitializeAsync ni instanciar AmazonCloudWatchLogsClient manualmente).
    - Serialización JSON estructurada automática con soporte para metadatos (Data) y niveles Debug, Info, Warning, Error y Critical.
    - Extensiones de inyección de dependencias (AddLoggingClient).
    - Fachada estática LogClient para uso rápido global.</PackageReleaseNotes>
    <ProjectUrl>https://github.com/JhoanHurtado/LoggingClient</ProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AWSSDK.CloudWatchLogs" Version="4.0.17.2" />
    <PackageReference Include="AWSSDK.Core" Version="4.0.3.26" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="9.0.8" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.8" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="" />
  </ItemGroup>
</Project>